{
  "$schema": "https://opencode.ai/config.json",
  "formatter": {
    "prettier": {
      "command": ["npx", "prettier", "--write", "$FILE"],
      "environment": {
        "NODE_ENV": "development"
      },
      "extensions": [".js", ".ts", ".jsx", ".tsx"]
    },
    "spotless": {
      "command": ["./gradlew", "spotlessApply"],
      "extensions": [".java", ".kt", ".kts"]
    }
  },
  "model": "{env:OPENCODE_DEFAULT_MODEL}",
  "default_agent": "build",
  "update": "auto",
  "share": "disabled",
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /", "effect": "deny" },
    { "action": "shell", "resource": "git push --force", "effect": "deny" }
  ],
  "agents": {
    "explore": {
      "disabled": true
    },
    "explainer": {
      "model": "{env:OPENCODE_EXPLAINER_MODEL}",
      "mode": "subagent",
      "request": {
        "body": {
          "temperature": 0.3
        }
      },
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },
    "planner": {
      "model": "{env:OPENCODE_PLANNER_MODEL}",
      "mode": "subagent",
      "request": {
        "body": {
          "temperature": 0.2
        }
      },
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },
    "coder": {
      "model": "{env:OPENCODE_CODER_MODEL}",
      "mode": "subagent",
      "request": {
        "body": {
          "temperature": 0.1
        }
      },
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" }
      ]
    },
    "explorer": {
      "model": "{env:OPENCODE_EXPLORER_MODEL}",
      "mode": "subagent",
      "request": {
        "body": {
          "temperature": 0.1
        }
      },
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "allow" }
      ]
    },
    "reviewer": {
      "model": "{env:OPENCODE_REVIEWER_MODEL}",
      "mode": "subagent",
      "request": {
        "body": {
          "temperature": 0
        }
      },
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "allow" }
      ]
    },
    "title": {
      "model": "{env:OPENCODE_SMALL_MODEL}"
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "disabled": false
      },
      "repomix": {
        "type": "local",
        "command": ["npx", "-y", "repomix", "--mcp"],
        "disabled": false
      },
      "tavily": {
        "type": "local",
        "command": ["npx", "-y", "tavily-mcp"],
        "environment": {
          "TAVILY_API_KEY": "{env:TAVILY_API_KEY}"
        },
        "disabled": false
      },
      "fetch": {
        "type": "local",
        "command": ["npx", "-y", "mcp-fetch-server"],
        "disabled": false
      }
    }
  },
  "lsp": {
    "typescript-lsp": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx"]
    },
    "dart-lsp": {
      "command": ["dart", "language-server"],
      "extensions": [".dart"]
    },
    "java-lsp": {
      "command": ["jdtls"],
      "extensions": [".java"]
    },
    "kotlin-lsp": {
      "command": ["kotlin-language-server"],
      "extensions": [".kt", ".kts"]
    },
    "swift-lsp": {
      "command": ["xcrun", "sourcekit-lsp"],
      "extensions": [".swift"]
    }
  },
  "plugins": [
    "@tarquinen/opencode-dcp@3.2.0",
    "@slkiser/opencode-quota@5.0.2",
    "@dietrichgebert/ponytail@5.1.0",
    "opencode-wakatime@1.4.0"
  ],
  "providers": {
    "openrouter": {},
    // Detected openai authentication; opencode-quota added this global provider declaration.
    "openai": {},
    // Ollama local model provider
    "ollama": {
      "package": "aisdk:@ai-sdk/openai",
      "settings": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "gpt-oss:latest": {
          "name": "GPT-OSS Local"
        }
      }
    }
  },
  "instructions": [
    "~/.config/opencode/rules/*.md"
  ]
}
