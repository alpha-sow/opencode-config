{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "todo": true
  },
  "formatter": {
    "prettier": {
      "command": ["npx", "prettier", "--write", "$FILE"],
      "environment": {
        "NODE_ENV": "development"
      },
      "extensions": [".js", ".ts", ".jsx", ".tsx"]
    },
    "spotless": {
      "command": ["./gradlew", "spotlessApply"],
      "extensions": [".java", ".kt", ".kts"]
    }
  },
  "model": "{env:OPENCODE_DEFAULT_MODEL}",
  "default_agent": "build",
  "update": "auto",
  "share": "disabled",
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /", "effect": "deny" },
    { "action": "shell", "resource": "git push --force", "effect": "deny" }
  ],
  "agents": {
    "explore": {
      "disabled": true
    },
    "plan": {
      "description": "Analyzes requests and prepares an action plan without delegating to subagents.",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "chat": {
      "description": "Chats and acts directly, without delegating to subagents.",
      "mode": "primary",
      "request": {
        "body": {
          "temperature": 0.3
        }
      },
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "explainer": {
      "description": "Explains code structure, logic, and architecture without modifying anything.",
      "model": "{env:OPENCODE_EXPLAINER_MODEL}",
      "mode": "subagent",
      "request": {
        "body": {
          "temperature": 0.3
        }
      },
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },
    "planner": {
      "description": "Designs technical plans, architecture, and breakdowns of complex tasks.",
      "model": "{env:OPENCODE_PLANNER_MODEL}",
      "mode": "subagent",
      "request": {
        "body": {
          "temperature": 0.2
        }
      },
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },
    "coder": {
      "description": "Implements features, fixes, refactorings, and related tests.",
      "model": "{env:OPENCODE_CODER_MODEL}",
      "mode": "subagent",
      "request": {
        "body": {
          "temperature": 0.1
        }
      },
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" }
      ]
    },
    "explorer": {
      "description": "Explores the repository: searches files, symbols, dependencies, and conventions.",
      "model": "{env:OPENCODE_EXPLORER_MODEL}",
      "mode": "subagent",
      "request": {
        "body": {
          "temperature": 0.1
        }
      },
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "allow" }
      ]
    },
    "reviewer": {
      "description": "Code review: defects, security, regressions, and acceptance criteria.",
      "model": "{env:OPENCODE_REVIEWER_MODEL}",
      "mode": "subagent",
      "request": {
        "body": {
          "temperature": 0
        }
      },
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "allow" }
      ]
    },
    "title": {
      "model": "{env:OPENCODE_SMALL_MODEL}"
    }
  },
  "mcp": {
    "servers": {
       "redmine": {
        "type": "local",
        "command": [
          "{env:HOME}/redmine-mcp/.venv/bin/python",
          "{env:HOME}/redmine-mcp/server.py"
        ],
        "disabled": true
      },
      "rydmike-flex_color_scheme_docs": {
        "type": "remote",
        "url": "https://docs.flexcolorscheme.com/mcp",
        "disabled": true
      },
      "intellij-idea": {
        "type": "remote",
        "disabled": true,
        "url": "http://127.0.0.1:64342/stream",
        "headers": {
          "IJ_MCP_SERVER_PROJECT_PATH": "{env:HOME}/wiser/range-analysis/backend"
        }
      },
      "datagrip-ide": {
        "type": "remote",
        "disabled": true,
        "url": "http://127.0.0.1:64402/stream",
        "headers": {
          "IJ_MCP_SERVER_PROJECT_PATH": "{env:HOME}/DataGripProjects/default"
        }
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "disabled": false
      },
      "sonar": {
        "type": "remote",
        "url": "{env:SONARQUBE_MCP_URL}",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:SONARQUBE_TOKEN}"
        },
        "disabled": true
      },
      "sonarqube": {
        "type": "local",
        "command": [
          "java",
          "-jar",
          "{env:HOME}/.local/share/sonarqube-mcp/sonarqube-mcp-server.jar"
        ],
        "environment": {
          "SONARQUBE_URL": "{env:SONARQUBE_ENTREPRISE_MCP_URL}",
          "SONARQUBE_TOKEN": "{env:SONARQUBE_ENTREPRISE_TOKEN}",
          "STORAGE_PATH": "{env:HOME}/.local/share/sonarqube-mcp/data"
        },
        "disabled": true
      },
      "repomix": {
        "type": "local",
        "command": ["npx", "-y", "repomix", "--mcp"],
        "disabled": false
      },
      "tavily": {
        "type": "local",
        "command": ["npx", "-y", "tavily-mcp"],
        "environment": {
          "TAVILY_API_KEY": "{env:TAVILY_API_KEY}"
        },
        "disabled": false
      },
      "fetch": {
        "type": "local",
        "command": ["npx", "-y", "mcp-fetch-server"],
        "disabled": false
      }
    }
  },
  "lsp": {
    "typescript": {
      "command": ["/opt/homebrew/bin/typescript-language-server", "--stdio"],
      "initialization": { "tsserver": { "path": "{env:HOME}/.local/share/opencode-ts/node_modules/typescript/lib/tsserver.js" } },
      "extensions": [".ts", ".tsx", ".js", ".jsx"]
    },
    "dart": {
      "command": ["{env:HOME}/develop/flutter/bin/dart", "language-server", "--protocol=lsp"],
      "extensions": [".dart"]
    },
    "jdtls": {
      "command": ["/opt/homebrew/bin/jdtls"],
      "extensions": [".java"]
    },
    "kotlin-ls": {
      "command": ["/opt/homebrew/bin/kotlin-language-server"],
      "env": { "JAVA_HOME": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home" },
      "extensions": [".kt", ".kts"]
    },
    "sourcekit-lsp": {
      "command": ["/usr/bin/xcrun", "sourcekit-lsp"],
      "extensions": [".swift"]
    }
  },
  "plugins": [
    "{env:HOME}/opencode-v2-lsp-support",
    "@tarquinen/opencode-dcp@3.2.0",
    "@slkiser/opencode-quota@6.0.0",
    "@dietrichgebert/ponytail@5.1.0",
    "opencode-wakatime@1.4.0"
  ],
  "providers": {
    "openrouter": {},
    "openai": {},
    "ollama": {
      "package": "aisdk:@ai-sdk/openai",
      "settings": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "gpt-oss:latest": {
          "name": "GPT-OSS Local"
        }
      }
    }
  },
  "instructions": [
    "~/.config/opencode/rules/*.md"
  ],
  "provider": {
    "copilot": {}
  }
}
