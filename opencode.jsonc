{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OPENCODE_DEFAULT_MODEL}",
  "small_model": "{env:OPENCODE_SMALL_MODEL}",
  "default_agent": "build",
  "agent": {
    "planner": {
      "model": "{env:OPENCODE_PLANNER_MODEL}",
      "mode": "subagent",
      "tools": {
        "write": false,
        "bash": false
      }
    },
    "coder": {
      "model": "{env:OPENCODE_CODER_MODEL}",
      "mode": "subagent",
      "tools": {
        "write": true,
        "bash": true
      }
    },
    "explore": {
      "model": "{env:OPENCODE_EXPLORE_MODEL}",
      "mode": "subagent",
      "tools": {
        "write": false,
        "bash": false
      }
    },
    "reviewer": {
      "model": "{env:OPENCODE_REVIEWER_MODEL}",
      "mode": "subagent",
      "tools": {
        "write": false,
        "bash": false
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "repomix": {
      "type": "local",
      "command": ["npx", "-y", "repomix", "--mcp"],
      "enabled": true
    }
  },
  "lsp": {
    "typescript-lsp": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx"]
    },
    "dart-lsp": {
      "command": ["dart", "language-server"],
      "extensions": [".dart"]
    },
    "java-lsp": {
      "command": ["jdtls"],
      "extensions": [".java"]
    },
    "kotlin-lsp": {
      "command": ["kotlin-language-server"],
      "extensions": [".kt", ".kts"]
    },
    "swift-lsp": {
      "command": ["xcrun", "sourcekit-lsp"],
      "extensions": [".swift"]
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "opencode-session-renamer",
    "@slkiser/opencode-quota@latest",
    "DietrichGebert/ponytail",
    "opencode-wakatime"
  ],
  "provider": {
    "openrouter": {},
    "alibaba-coding-plan": {},
    "copilot": {},
    // Detected openai authentication; opencode-quota added this global provider declaration.
    "openai": {},
    // Ollama local model provider
    "ollama": {
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "gpt-oss:latest": {
          "name": "GPT-OSS Local"
        }
      }
    },
    // Detected xai authentication; opencode-quota added this global provider declaration.
    "xai": {}
  },
  "instructions": [
    ".opencode/rules/*.md"
  ]
}
