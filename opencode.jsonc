{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "agent": {
    "planner": {
      "model": "alibaba/qwen3.7-plus",
      "mode": "subagent",
      "tools": {
        "write": false,
        "bash": false
      }
    },
    "coder": {
      "model": "alibaba/qwen3-coder-plus",
      "mode": "subagent",
      "tools": {
        "write": true,
        "bash": true
      }
    },
    "explore": {
      "model": "opencode/deep-seek-v4-flash",
      "mode": "subagent",
      "tools": {
        "write": false,
        "bash": false
      }
    },
    "reviewer": {
      "model": "opencode/big-pickle",
      "mode": "subagent",
      "tools": {
        "write": false,
        "bash": false
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "repomix": {
      "type": "local",
      "command": ["npx", "-y", "repomix", "--mcp"],
      "enabled": true
    }
  },
  "lsp": {
    "typescript-lsp": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx"]
    },
    "dart-lsp": {
      "command": ["dart", "language-server"],
      "extensions": [".dart"]
    },
    "java-lsp": {
      "command": ["jdtls"],
      "extensions": [".java"]
    },
    "kotlin-lsp": {
      "command": ["kotlin-language-server"],
      "extensions": [".kt", ".kts"]
    },
    "swift-lsp": {
      "command": ["xcrun", "sourcekit-lsp"],
      "extensions": [".swift"]
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "opencode-session-renamer",
    "@slkiser/opencode-quota@latest",
    "DietrichGebert/ponytail",
    "opencode-wakatime"
  ],
  "provider": {
    "openrouter": {},
    "alibaba-coding-plan": {},
    "copilot": {}
  },
  "instructions": [
    ".opencode/rules/*.md"
  ]
}
