{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-5c02f211-d065-49e3-8ffa-8397562ec177"
      }
    }
  },
  // OpenCode Quota: tuiCommandDisplay chooses whether native TUI command output appears in the session transcript or a local popup dialog.
  // OpenCode Quota: loads the server plugin for slash commands and quota checks.
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "opencode-session-renamer",
    "@slkiser/opencode-quota@latest"
  ],
  "provider": {
    // Detected openrouter authentication; opencode-quota added this global provider declaration.
    "openrouter": {},
    // Detected alibaba-coding-plan authentication; opencode-quota added this global provider declaration.
    "alibaba-coding-plan": {},
    // Detected copilot authentication; opencode-quota added this global provider declaration.
    "copilot": {},
    // ollama
    "ollama": {
      "type": "openai",
      "name": "Ollama Local",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3.5-ultra": {
          "name": "Qwen 3.5 Ultra (Local)"
        },
        "qwen3.5-ultra:latest": {
          "name": "Qwen 3.5 Ultra (Local)"
        },
        "opencoder": {
          "name": "OpenCoder (Local)"
        },
        "opencoder:latest": {
          "name": "OpenCoder (Local)"
        }
      }
    }
  },
  "instructions": [
    "CONTRIBUTING.md",
    "docs/guidelines.md",
    ".opencode/rules/*.md",
    "~/.config/opencode/rules/*.md"
  ]
}
